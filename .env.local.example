# === DeepSeek 配置（当前使用） ===
# 从 https://platform.deepseek.com/api_keys 获取
OPENAI_API_KEY=你刚才拿到的 DeepSeek API Key

# DeepSeek API 端点
OPENAI_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 模型（deepseek-chat 便宜，deepseek-reasoner 更强但贵）
LLM_MODEL=deepseek-v4-flash

# === 备选：OpenAI 配置（充值后可切回） ===
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# === x402 Payment Gate (v2.4.1) ===
# 与 lib/x402/config.ts 字段名严格一致

# 整体闸门
X402_DISABLED=false          # true = 关闭闸门回 v2.4.0 免费行为
X402_FREE_MODE=false         # true = demo 模式：走完整 402 流程但不收钱（便于审计）

# 收款与资产
X402_PAYTO=0xYourXLayerWallet                                # 收款地址（X Layer EVM），必填（freeMode=false 时）
X402_ASSET_ADDRESS=0x1e4a5963ab79e612984b2e88b8d96053bfd975d8 # USDT0 on X Layer，默认值
X402_NETWORK=eip155:196                                       # CAIP-2
X402_PRICE_USD=0.005                                          # 单次价格（人类单位，USD）
X402_ASSET_DECIMALS=6                                         # USDT 精度
X402_MAX_TIMEOUT_SECONDS=300                                  # 签名有效期（秒）

# EIP-712 domain
X402_EIP712_NAME=USDT0
X402_EIP712_VERSION=2

# Facilitator (OKX 官方)
X402_FACILITATOR_BASE=https://web3.okx.com/api/v6/pay/x402

# OKX API Key（HMAC 鉴权用），必填（freeMode=false 时）
# 从 https://web3.okx.com/zh-hans/onchainos/dev-portal 申请
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 运行参数
X402_MAX_DURATION_MS=55000       # 单次业务预算（Vercel 60s 留 5s 给 settle）
X402_IDEMPOTENCY_TTL_SEC=86400   # 幂等缓存 TTL（秒）
